# =============================================================================
# ClaimSage - Environment Configuration Template
# All secrets must use secure, environment-specific values in production.
# =============================================================================

# Application Core
APP_NAME=ClaimSage
APP_ENV=development

# Database Configuration (PostgreSQL 16 with pgvector)
POSTGRES_DB=claimsage
POSTGRES_USER=claimsage_app
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT_BINDING=127.0.0.1:5432
DATABASE_URL=postgresql+psycopg://claimsage_app:change-this-local-password@127.0.0.1:5432/claimsage

# Authentication & Security
# Minimum 32 characters required for HS256 JWT signing
JWT_SECRET_KEY=change-this-jwt-secret-key-minimum-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Primary LLM Provider: Groq Cloud
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=
GROQ_MAX_OUTPUT_TOKENS=4096
GROQ_TIMEOUT_SECONDS=60.0
GROQ_MAX_RETRIES=3
GROQ_CONCURRENCY_LIMIT=2
GROQ_PACING_DELAY_SECONDS=16.0

# Secondary LLM Provider: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Object Storage (MinIO / S3 Compatible)
STORAGE_BACKEND=s3
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_BUCKET_NAME=claimsage-documents
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=claimsage_minio_admin
STORAGE_SECRET_KEY=change-this-minio-password
STORAGE_USE_SSL=false
STORAGE_AUTO_CREATE_BUCKET=true

# Email & Notification Services
# sandbox: persists outgoing emails to customer_emails outbox without dispatching
# smtp: dispatches real emails via standard SMTP server
EMAIL_BACKEND=sandbox
EMAIL_FROM_ADDRESS=claimsage-noreply@example.invalid
EMAIL_APP_BASE_URL=http://localhost:8080
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=

# Frontend Configuration
FRONTEND_PORT=8080
